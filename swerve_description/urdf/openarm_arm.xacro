<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="pkg_path" value="$(find swerve_description)"/>

    <!-- Openarm Arm Right -->

    <joint name="right_link0_joint" type="fixed">
        <parent link="body_link0"/>
        <child link="right_link0"/>
        <origin xyz="0 0 0.697" rpy="1.57 0 0"/>
    </joint>

    <link name="right_link0">
        <visual>
            <origin xyz="0 0 0.03"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/openarm_link0.dae" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.03"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/openarm_link0.dae" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.005" ixy="0.0" ixz="0.0"
                     iyy="0.005" iyz="0.0"
                     izz="0.005"/>
        </inertial>
    </link>

    <!-- joint1 -->

    <joint name="right_link1_joint" type="revolute">
        <parent link="right_link0"/>
        <child link="right_link1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="50" velocity="2.0"/>
    </joint>

    <link name="right_link1">
        <visual>
            <origin xyz="0 0 0.03"/>
