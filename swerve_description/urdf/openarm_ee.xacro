<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="pkg_path" value="$(find swerve_description)"/>

    <!-- Openarm Right Endeffector -->

    <joint name="right_hand_joint" type="fixed">
        <parent link="right_link7"/>
        <child link="right_hand"/>
        <origin xyz="0 0 0.097" rpy="0 0 0"/>
    </joint>

    <link name="right_hand">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.20"/>
            <inertia
                ixx="0.0005" ixy="0.0" ixz="0.0"
                iyy="0.0005" iyz="0.0"
                izz="0.0005"/>
        </inertial>

        <visual>
            <origin xyz="0 0 -0.655" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/openarm_hand.dae" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 -0.655" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.04 0.10"/>
            </geometry>
        </collision>
    </link>

    <joint name="right_finger1_joint" type="fixed">
        <parent link="right_hand"/>
        <child link="right_finger1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="right_finger1">
        <inertial>
            <origin xyz="0 -0.01 0" rpy="0 0 0"/>
            <mass value="0.05"/>
            <inertia
                ixx="0.00005" ixy="0.0" ixz="0.0"
                iyy="0.00005" iyz="0.0"
                izz="0.00005"/>
        </inertial>

        <visual>
            <origin xyz="0 -0.01 -0.655" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/openarm_finger.dae" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 -0.01 -0.655" rpy="0 0 0"/>
            <geometry>
                <box size="0.015 0.015 0.08"/>
            </geometry>
        </collision>
    </link>

    <joint name="right_finger2_joint" type="fixed">
        <parent link="right_hand"/>
        <child link="right_finger2"/>
        <origin xyz="0 0 0" rpy="0 0 3.141592"/>
    </joint>

    <link name="right_finger2">
        <inertial>
            <origin xyz="0 -0.01 -0.655" rpy="0 0 0"/>
            <mass value="0.05"/>
            <inertia
                ixx="0.00005" ixy="0.0" ixz="0.0"
                iyy="0.00005" iyz="0.0"
                izz="0.00005"/>
        </inertial>

        <visual>
            <origin xyz="0 -0.01 -0.655" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/openarm_finger.dae" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 -0.01 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.015 0.015 0.08"/>
            </geometry>
        </collision>
    </link>


    <!-- Openarm Left Endeffector -->
     
    <!-- Openarm Left Endeffector -->
     
    <joint name="left_hand_joint" type="fixed">
        <parent link="left_link7"/>
        <child link="left_hand"/>
        <origin xyz="0 0 0.097" rpy="0 0 0"/>
    </joint>

    <link name="left_hand">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.20"/>
            <inertia
                ixx="0.0005" ixy="0.0" ixz="0.0"
                iyy="0.0005" iyz="0.0"
                izz="0.0005"/>
        </inertial>

        <visual>
            <origin xyz="0 0 -0.655" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/openarm_hand.dae" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 -0.655" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.04 0.10"/>
            </geometry>
        </collision>
    </link>

    <joint name="left_finger1_joint" type="fixed">
        <parent link="left_hand"/>
        <child link="left_finger1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="left_finger1">
        <inertial>
            <origin xyz="0 -0.01 0" rpy="0 0 0"/>
            <mass value="0.05"/>
            <inertia
                ixx="0.00005" ixy="0.0" ixz="0.0"
                iyy="0.00005" iyz="0.0"
                izz="0.00005"/>
        </inertial>

        <visual>
            <origin xyz="0 -0.01 -0.655" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/openarm_finger.dae" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 -0.01 -0.655" rpy="0 0 0"/>
            <geometry>
                <box size="0.015 0.015 0.08"/>
            </geometry>
        </collision>
    </link>

    <joint name="left_finger2_joint" type="fixed">
        <parent link="left_hand"/>
        <child link="left_finger2"/>
        <origin xyz="0 0 0" rpy="0 0 3.141592"/>
    </joint>

    <link name="left_finger2">
        <inertial>
            <origin xyz="0 -0.01 -0.655" rpy="0 0 0"/>
            <mass value="0.05"/>
            <inertia
                ixx="0.00005" ixy="0.0" ixz="0.0"
                iyy="0.00005" iyz="0.0"
                izz="0.00005"/>
        </inertial>

        <visual>
            <origin xyz="0 -0.01 -0.655" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/openarm_finger.dae" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 -0.01 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.015 0.015 0.08"/>
            </geometry>
        </collision>
    </link>

</robot>