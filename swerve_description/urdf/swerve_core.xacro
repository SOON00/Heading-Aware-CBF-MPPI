<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro"/>
    <xacro:include filename="materials.xacro"/>

    <xacro:property name="pkg_path" value="$(find swerve_description)"/>

    <!-- BASE_FOOTPRINT LINK -->

    <link name="base_footprint">

    </link>

    <!-- BASE_LINK -->

    <link name="base_link">

    </link>

    <joint name="base_link_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- CHASSIS -->

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis_link"/>
        <origin xyz="-0.40 0 0"/>
    </joint>

    <link name="chassis_link">
        <visual>
            <origin xyz="0 -0.2 0" rpy="1.57 0 1.57"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/swerve_body.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name='white'/>
        </visual>
        <collision>
            <origin xyz="0 -0.2 0" rpy="1.57 0 1.57"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/swerve_body.dae" scale="0.001 0.001 0.001"/>
            </geometry>       
        </collision>
        <xacro:inertial_box mass="5.0" x="0.8" y="0.4" z='0.13'>
            <origin xyz="0.40 0 0.065" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <!-- FRONT_LEFT_WHEEL -->

    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="front_left_steer_link"/>
        <child link="front_left_wheel_link"/>
        <origin xyz="0 0 -0.0775" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="front_left_wheel_link">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.065" length="0.0628"/>
            </geometry>
            <material name='black'/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.065" length="0.0628"/>
            </geometry>            
        </collision>
        <xacro:inertial_cylinder mass="2.0" length="0.0628" radius="0.065">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- FRONT_RIGHT_WHEEL -->

    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="front_right_steer_link"/>
        <child link="front_right_wheel_link"/>
        <origin xyz="0 0 -0.0775" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="front_right_wheel_link">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.065" length="0.0628"/>
            </geometry>
            <material name='black'/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.065" length="0.0628"/>
            </geometry>            
        </collision>
        <xacro:inertial_cylinder mass="2.0" length="0.0628" radius="0.065">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- REAR_LEFT_WHEEL -->

    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="rear_left_steer_link"/>
        <child link="rear_left_wheel_link"/>
        <origin xyz="0 0 -0.0775" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="rear_left_wheel_link">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.065" length="0.0628"/>
            </geometry>
            <material name='black'/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.065" length="0.0628"/>
            </geometry>            
        </collision>
        <xacro:inertial_cylinder mass="2.0" length="0.0628" radius="0.065">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- REAR_RIGHT_WHEEL -->

    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="rear_right_steer_link"/>
        <child link="rear_right_wheel_link"/>
        <origin xyz="0 0 -0.0775" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="rear_right_wheel_link">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.065" length="0.0628"/>
            </geometry>
            <material name='black'/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.065" length="0.0628"/>
            </geometry>            
        </collision>
        <xacro:inertial_cylinder mass="2.0" length="0.0628" radius="0.065">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- FRONT_LEFT_STEER -->

    <joint name="front_left_steer_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_steer_link"/>
        <origin xyz="0.35 0.151 -0.0075"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="front_left_steer_link">
        <visual>
            <origin xyz="-0.004 -0.004 0.004"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/swerve_steering_shaft.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name='gray'/>
        </visual>
        <collision>
            <origin xyz="-0.004 -0.004 0.004"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/swerve_steering_shaft.dae" scale="0.001 0.001 0.001"/>
            </geometry>            
        </collision>
        <xacro:inertial_cylinder mass="0.5" length="0.015" radius="0.02">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- FRONT_RIGHT_STEER -->

    <joint name="front_right_steer_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_steer_link"/>
        <origin xyz="0.35 -0.148 -0.0075"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="front_right_steer_link">
        <visual>
            <origin xyz="-0.004 -0.002 0.004"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/swerve_steering_shaft.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name='gray'/>
        </visual>
        <collision>
            <origin xyz="-0.004 -0.002 0.004"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/swerve_steering_shaft.dae" scale="0.001 0.001 0.001"/>
            </geometry>            
        </collision>
        <xacro:inertial_cylinder mass="0.5" length="0.015" radius="0.02">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- REAR_LEFT_STEER -->

    <joint name="rear_left_steer_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_left_steer_link"/>
        <origin xyz="-0.35 0.152 -0.0075"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="rear_left_steer_link">
        <visual>
            <origin xyz="-0.002 -0.004 0.004"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/swerve_steering_shaft.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name='gray'/>
        </visual>
        <collision>
            <origin xyz="-0.002 -0.004 0.004"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/swerve_steering_shaft.dae" scale="0.001 0.001 0.001"/>
            </geometry>            
        </collision>
        <xacro:inertial_cylinder mass="0.5" length="0.015" radius="0.02">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- REAR_RIGHT_STEER -->

    <joint name="rear_right_steer_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_right_steer_link"/>
        <origin xyz="-0.35 -0.147 -0.0075"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="rear_right_steer_link">
        <visual>
            <origin xyz="-0.002 -0.002 0.004"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/swerve_steering_shaft.dae" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name='gray'/>
        </visual>
        <collision>
            <origin xyz="-0.002 -0.002 0.004"/>
            <geometry>
                <mesh filename="file://${pkg_path}/meshes/swerve_steering_shaft.dae" scale="0.001 0.001 0.001"/>
            </geometry>            
        </collision>
        <xacro:inertial_cylinder mass="0.5" length="0.015" radius="0.02">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

</robot>
